@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<section class="auth-page"><div class="auth-card">
    <div class="auth-intro"><span class="auth-icon" aria-hidden="true">♙</span><p class="eyebrow">TU ESPACIO TECNOSOFT</p><h1>Bienvenido de vuelta.</h1><p>Ingresa para acceder a tu cuenta y tus futuros pedidos.</p><div class="auth-intro-footer">TECNOLOGÍA QUE SÍ TE ENTIENDE <span>↗</span></div></div>
    <div class="auth-form-panel"><a class="auth-close" asp-controller="Home" asp-action="Index" aria-label="Volver al inicio">×</a><span class="form-kicker">INICIAR SESIÓN / 01</span><h2>Accede a tu cuenta</h2>
        <form asp-action="Login" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
            <div class="field"><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" placeholder="nombre@correo.com" /><span asp-validation-for="Email" class="field-error"></span></div>
            <div class="field"><label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="current-password" placeholder="••••••••••" /><span asp-validation-for="Password" class="field-error"></span></div>
            <button class="btn-primary auth-submit" type="submit">INICIAR SESIÓN <span aria-hidden="true">→</span></button>
        </form>
        <p class="auth-switch">¿No tienes cuenta? <a asp-action="Register">Regístrate gratis</a></p>
    </div>
</div></section>
