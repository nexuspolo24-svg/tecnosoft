@model RegisterViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}
<section class="auth-page"><div class="auth-card">
    <div class="auth-intro"><span class="auth-icon" aria-hidden="true">✦</span><p class="eyebrow">TU ESPACIO TECNOSOFT</p><h1>Empecemos juntos.</h1><p>Crea tu cuenta para tener tus datos listos cuando hagas un pedido.</p><div class="auth-intro-footer">TECNOLOGÍA QUE SÍ TE ENTIENDE <span>↗</span></div></div>
    <div class="auth-form-panel"><a class="auth-close" asp-controller="Home" asp-action="Index" aria-label="Volver al inicio">×</a><span class="form-kicker">CREAR CUENTA / 02</span><h2>Regístrate gratis</h2>
        <form asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>
            <div class="field"><label asp-for="FullName"></label><input asp-for="FullName" autocomplete="name" placeholder="Tu nombre" /><span asp-validation-for="FullName" class="field-error"></span></div>
            <div class="field"><label asp-for="Email"></label><input asp-for="Email" type="email" autocomplete="email" placeholder="nombre@correo.com" /><span asp-validation-for="Email" class="field-error"></span></div>
            <div class="field"><label asp-for="Password"></label><input asp-for="Password" type="password" autocomplete="new-password" placeholder="Mínimo 10 caracteres" /><span asp-validation-for="Password" class="field-error"></span></div>
            <div class="field"><label asp-for="ConfirmPassword"></label><input asp-for="ConfirmPassword" type="password" autocomplete="new-password" placeholder="Repite tu contraseña" /><span asp-validation-for="ConfirmPassword" class="field-error"></span></div>
            <button class="btn-primary auth-submit" type="submit">CREAR CUENTA <span aria-hidden="true">→</span></button>
        </form>
        <p class="auth-switch">¿Ya tienes cuenta? <a asp-action="Login">Inicia sesión</a></p>
    </div>
</div></section>
