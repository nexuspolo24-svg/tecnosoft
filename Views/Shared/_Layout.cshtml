<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · TecnoSoft Solutions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Mono:wght@400;500&family=Playfair+Display:wght@500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <div class="shell header-inner">
            <a class="brand" asp-controller="Home" asp-action="Index" aria-label="TecnoSoft Solutions, inicio">
                <span class="brand-mark">T<span>·</span></span>
                <span class="brand-name">TecnoSoft<small>SOLUTIONS</small></span>
            </a>
            <nav class="main-nav" aria-label="Navegación principal">
                <a href="/#productos">Catálogo</a>
                <a href="/#servicios">Servicios</a>
                <a href="/#nosotros">Nosotros</a>
                <a href="/#contacto">Soporte</a>
            </nav>
            <div class="header-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span class="greeting">Hola, @User.Identity.Name</span>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button class="header-pill" type="submit">Cerrar sesión</button>
                    </form>
                }
                else
                {
                    <a class="header-pill" asp-controller="Account" asp-action="Login">Iniciar sesión <span aria-hidden="true">↗</span></a>
                }
                <button class="cart-button" type="button" aria-label="Carrito próximamente" title="Carrito próximamente">⌑</button>
            </div>
        </div>
    </header>
    <main role="main">@RenderBody()</main>
    <footer class="site-footer">
        <div class="shell footer-inner">
            <span>© 2026 TecnoSoft Solutions · Tecnología sin complicaciones.</span>
            <a href="mailto:tecnosoftsolutions@gmail.com">tecnosoftsolutions@gmail.com</a>
        </div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
